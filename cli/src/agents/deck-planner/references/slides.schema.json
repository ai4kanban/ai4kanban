{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI4Kanban slide storyboard",
  "description": "Structure only. This agent's `scripts/validate-storyboard.mjs` also checks unique slide IDs and that every preview is a readable same-card image at most 1280px wide. Array order is page order.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "slides"],
  "properties": {
    "version": { "const": 1 },
    "slides": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/slide" } }
  },
  "$defs": {
    "text": { "type": "string", "pattern": "\\S" },
    "slide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "copy", "notes", "layout", "assets", "preview"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "title": { "$ref": "#/$defs/text" },
        "copy": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "notes": { "type": "string" },
        "layout": { "$ref": "#/$defs/text" },
        "assets": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "preview": {
          "type": "object",
          "additionalProperties": false,
          "required": ["src", "alt"],
          "properties": {
            "src": { "type": "string", "pattern": "^\\.assets/[1-9][0-9]*/([^./\\\\][^/\\\\]*/)*[^./\\\\][^/\\\\]*\\.(png|jpe?g|webp|gif)$" },
            "alt": { "$ref": "#/$defs/text" }
          }
        }
      }
    }
  }
}
