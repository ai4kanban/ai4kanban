{
  "name": "ai4kanban",
  "version": "0.5.1",
  "description": "Set up and update AI4Kanban in one command — copies the skill into your project and scaffolds the Markdown board under docs/kanban/.",
  "keywords": [
    "kanban",
    "claude",
    "claude-code",
    "codex",
    "agent",
    "skill",
    "markdown",
    "board"
  ],
  "license": "Apache-2.0",
  "homepage": "https://ai4kanban.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai4kanban/ai4kanban.git",
    "directory": "cli"
  },
  "type": "module",
  "bin": {
    "ai4kanban": "bin/ai4kanban.mjs",
    "akb": "bin/ai4kanban.mjs"
  },
  "files": [
    "bin/",
    "skill/"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "npm run typecheck && node scripts/build.mjs --check",
    "bundle": "node scripts/bundle-skill.mjs",
    "prepublishOnly": "node ../scripts/sync-version.mjs --check && npm run build && npm run bundle"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
