{
  "name": "ai4kanban",
  "version": "0.8.1",
  "description": "AI4Kanban's `akb` command \u2014 scaffold the Markdown board under docs/kanban/, put an agent on a card, and carry the flows the agent works by.",
  "keywords": [
    "kanban",
    "claude",
    "claude-code",
    "codex",
    "agent",
    "skill",
    "markdown",
    "board"
  ],
  "license": "Apache-2.0",
  "homepage": "https://ai4kanban.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai4kanban/ai4kanban.git",
    "directory": "cli"
  },
  "type": "module",
  "bin": {
    "ai4kanban": "bin/ai4kanban.mjs",
    "akb": "bin/ai4kanban.mjs"
  },
  "files": [
    "bin/",
    "dist/"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/test.mjs",
    "lint": "npm run typecheck",
    "prepublishOnly": "npm run build && node ../scripts/sync-version.mjs --check"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
