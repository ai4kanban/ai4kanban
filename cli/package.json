{
  "name": "wildcrane",
  "version": "0.11.28",
  "akbContract": 7,
  "description": "WildCrane's `akb` command — scaffold the Markdown board under docs/kanban/, put an agent on a card, and carry the flows the agent works by.",
  "keywords": [
    "kanban",
    "claude",
    "claude-code",
    "codex",
    "agent",
    "skill",
    "markdown",
    "board"
  ],
  "license": "FSL-1.1-ALv2",
  "homepage": "https://wildcrane.ai/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wildcrane-ai/wildcrane.git",
    "directory": "cli"
  },
  "type": "module",
  "bin": {
    "akb": "bin/ai4kanban.mjs",
    "wildcrane": "bin/ai4kanban.mjs"
  },
  "files": [
    "bin/",
    "dist/"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
