{
  // /demo draws kanban-ui's screens, whose `@/` is kanban-ui's root — so it is checked as its
  // own program. The site's program stops at app/(demo)/demo/screen.d.ts.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "paths": {
      "@/*": ["../kanban-ui/*"],
      "@demo/screen": ["./app/(demo)/demo/Screen.tsx"],
      // Packages come from this app first, as the bundle's do (next.config.mjs).
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "*": ["./node_modules/*", "./node_modules/@types/*"]
    }
  },
  "include": ["app/(demo)/**/*.ts", "app/(demo)/**/*.tsx", "next-env.d.ts"],
  "exclude": ["node_modules"]
}
