{
  // Typechecking only — esbuild builds (scripts/build.mjs). Reaches into ../cli/src for the
  // code the Runner shares with the CLI.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    // Shared ../cli/src code resolves its packages here.
    "paths": { "*": ["./node_modules/@types/*", "./node_modules/*"] }
  },
  "include": ["src", "test", "../cli/src/lib/agents/text-imports.d.ts", "../cli/src/guide/guides.d.ts"]
}
