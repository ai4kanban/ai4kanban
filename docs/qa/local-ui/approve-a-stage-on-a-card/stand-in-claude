#!/usr/bin/env node
// Stand-in Claude Code: signed in, no model. A run reads its prompt from stdin, runs
// /tmp/lui/act.sh (if present) with the prompt on stdin, then reports done.
const fs = require('fs'), cp = require('child_process')
const a = process.argv.slice(2)
if (a.includes('--version')) { console.log('2.1.99 (Claude Code)'); process.exit(0) }
if (a[0] === 'auth') { console.log(JSON.stringify({ loggedIn: true, authMethod: 'claude.ai', apiProvider: 'firstParty' })); process.exit(0) }
const out = (ev) => process.stdout.write(JSON.stringify(ev) + '\n')
let buf = ''
let ran = false
const done = () => {
  if (ran) return; ran = true
  let text = buf
  try { const m = JSON.parse(buf.split('\n')[0]).message.content; text = typeof m === 'string' ? m : m.map((c) => c.text ?? '').join('\n') } catch {}
  fs.appendFileSync('/tmp/lui/standin-prompts.log', `=== ${new Date().toISOString()} ${a.join(' ').slice(0, 200)}\n${text.slice(0, 4000)}\n`)
  const act = '/tmp/lui/act.sh'
  setTimeout(() => {
    if (fs.existsSync(act)) try { cp.execFileSync('/bin/zsh', [act], { input: text, stdio: ['pipe', 'ignore', 'ignore'] }) } catch {}
    out({ type: 'system', subtype: 'init', model: 'stand-in' })
    out({ type: 'assistant', message: { content: [{ type: 'text', text: 'Done (stand-in).' }] } })
    out({ type: 'result', result: 'Done (stand-in).', total_cost_usd: 0, usage: { input_tokens: 1, output_tokens: 1 } })
    process.exit(0)
  }, Number(process.env.STANDIN_MS ?? 3000))
}
process.stdin.on('data', (d) => { buf += d; if (buf.includes('\n')) { process.stdin.pause(); done() } })
process.stdin.on('end', () => { done() })
