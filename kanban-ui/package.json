{
  "name": "ai4kanban-ui",
  "version": "0.8.0",
  "description": "Local kanban board UI \u2014 run it on your machine to see the board and spawn agents (claude -p) to do the kanban work. Files in docs/kanban/ stay the source of truth.",
  "keywords": [
    "kanban",
    "claude",
    "claude-code",
    "agent",
    "markdown",
    "board",
    "ui"
  ],
  "license": "Apache-2.0",
  "homepage": "https://ai4kanban.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai4kanban/ai4kanban.git",
    "directory": "kanban-ui"
  },
  "bin": {
    "ai4kanban-ui": "bin/kanban-ui.mjs"
  },
  "files": [
    "bin/",
    ".next/standalone/"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "npm --prefix ../cli run build && AI4KANBAN_CLI=../cli/dist/kanban.mjs next dev",
    "build": "next build",
    "build:standalone": "next build && node scripts/copy-standalone-assets.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "node ../scripts/sync-format.mjs --check && eslint .",
    "prepublishOnly": "node ../scripts/sync-version.mjs --check && node ../scripts/sync-format.mjs --check && npm run build:standalone"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^9.0.1",
    "react-resizable-panels": "^4.12.2",
    "remark-gfm": "^4.0.0",
    "sucrase": "^3.35.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.0.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.20",
    "postcss": "^8.5.0",
    "typescript": "^5.7.0"
  }
}
