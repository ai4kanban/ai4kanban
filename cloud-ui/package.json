{
  "name": "ai4kanban-cloud-ui",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN ../LICENSE",
  "description": "The hosted pages at cloud.ai4kanban.dev \u2014 a Cloud workspace's board and its cards, read-only in a browser.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "env -u HTTP_PROXY -u HTTPS_PROXY -u http_proxy -u https_proxy -u ALL_PROXY -u all_proxy opennextjs-cloudflare build && env -u HTTP_PROXY -u HTTPS_PROXY -u http_proxy -u https_proxy -u ALL_PROXY -u all_proxy opennextjs-cloudflare deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && npm run typecheck"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.4",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "ai4kanban-ui": "file:../kanban-ui",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^9.0.1",
    "react-resizable-panels": "^4.12.2",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.0.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.20",
    "postcss": "^8.5.26",
    "typescript": "^5.7.0",
    "wrangler": "^4.125.0"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
